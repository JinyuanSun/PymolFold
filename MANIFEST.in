include LICENSE
include README.md
include pyproject.toml
include pymolfold.py
include pymolfold/gui/ccd_keys.json

recursive-include pymolfold *.py
recursive-include pymolfold/predictors *.py
recursive-include pymolfold/gui *.py
recursive-include pymolfold *.md
recursive-include tests *.py

global-exclude *.pyc
global-exclude __pycache__
global-exclude *.pyo
global-exclude .git

include scripts/check_release.py
include RELEASE.md
